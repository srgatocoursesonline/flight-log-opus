# MSFS Companion Service Configuration

# Backend URL do Flight Log Opus
BACKEND_URL=http://localhost:3000

# Portas do Companion Service
EXPRESS_PORT=3001
WS_PORT=3002

# Configurações de detecção de voo
MIN_SPEED_TAKEOFF=30
MIN_SPEED_LANDING=10
MIN_ALTITUDE_FLIGHT=100
GROUND_THRESHOLD=5

# Intervalo de coleta de dados (ms)
DATA_INTERVAL=1000

# Configurações de debug
DEBUG=false
LOG_LEVEL=info