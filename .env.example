# ============================================
# SUPABASE CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env.local and fill in your actual Supabase values
# Get these values from: https://app.supabase.com/project/[PROJECT_ID]/settings/api

# Variáveis de ambiente do Supabase
# Substitua pelos valores reais da sua conta do Supabase
# Encontre esses valores em: https://app.supabase.io > Projeto > Settings > API

# URL da API do Supabase
VITE_SUPABASE_URL=https://exemplo.supabase.co

# Chave anônima (pública) do Supabase
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_supabase

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
VITE_APP_ENV=development