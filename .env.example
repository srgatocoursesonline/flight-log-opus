# ============================================
# SUPABASE CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env.local and fill in your actual Supabase values
# Get these values from: https://app.supabase.com/project/[PROJECT_ID]/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon public key (safe to use in client-side code)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
VITE_APP_ENV=development