# ============================================
# GATEWAY — PostgreSQL próprio (API compatível Supabase)
# ============================================

PORT=4001

# Conexão PostgreSQL (gerada por migration/setup_local_db.sh)
DATABASE_URL=postgresql://flightlog_conn:SENHA@127.0.0.1:5433/flight_log_opus

# Segredo de assinatura dos JWTs (generate_keys.sh gera)
JWT_SECRET=

# Chaves "apikey" emitidas localmente (generate_keys.sh gera)
ANON_KEY=
SERVICE_KEY=

# Emissão de token (segundos de vida do access_token)
ACCESS_TOKEN_EXPIRES_IN=3600
REFRESH_TOKEN_EXPIRES_IN=2592000

# Rate limit de login
LOGIN_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# SMTP para e-mails de confirmação/recuperação.
# Se ausente: signup auto-confirma e reset só gera token no banco.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Flight Log Opus <no-reply@rsolutionsbr.com>"

# CORS (normalmente o nginx já atende same-origin; mantenha para dev local)
CORS_ORIGINS=https://fs.rsolutionsbr.com,http://localhost:8080
