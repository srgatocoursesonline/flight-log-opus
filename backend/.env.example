# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================

# Porta do servidor
PORT=3001

# Ambiente (development, production, test)
NODE_ENV=development

# URL base da API
API_BASE_URL=http://localhost:3001

# ============================================
# CONFIGURAÇÕES DO SUPABASE
# ============================================

# URL do projeto Supabase
SUPABASE_URL=https://your-project.supabase.co

# Chave pública do Supabase (anon key)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Chave de serviço do Supabase (service role key) - CUIDADO!
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ============================================
# CONFIGURAÇÕES DE CORS
# ============================================

# URLs permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://flight-log-opus.pages.dev

# ============================================
# CONFIGURAÇÕES DE RATE LIMITING
# ============================================

# Limite de requisições por IP (por janela de tempo)
RATE_LIMIT_MAX=100

# Janela de tempo em minutos
RATE_LIMIT_WINDOW=15

# ============================================
# CONFIGURAÇÕES DO WEBSOCKET
# ============================================

# Porta do WebSocket (se diferente do servidor HTTP)
WS_PORT=3002

# Habilitar WebSocket
WS_ENABLED=true

# ============================================
# CONFIGURAÇÕES DE LOGGING
# ============================================

# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# Habilitar logs de requisições HTTP
HTTP_LOGGING=true

# ============================================
# CONFIGURAÇÕES DE CACHE
# ============================================

# Duração do cache de aeroportos em horas
AIRPORT_CACHE_DURATION=24

# Habilitar cache de aeroportos
AIRPORT_CACHE_ENABLED=true

# ============================================
# CONFIGURAÇÕES DE APIS EXTERNAS
# ============================================

# URL da API OurAirports
OURAIRPORTS_API_URL=https://davidmegginson.github.io/ourairports-data/airports.csv

# Timeout para requisições externas (em ms)
EXTERNAL_API_TIMEOUT=30000

# ============================================
# CONFIGURAÇÕES DE SEGURANÇA
# ============================================

# Chave secreta para JWT (se implementado)
JWT_SECRET=your-super-secret-jwt-key

# Habilitar HTTPS redirect
FORCE_HTTPS=false

# ============================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ============================================

# Habilitar modo debug
DEBUG=false

# Habilitar hot reload
HOT_RELOAD=true

# Mostrar stack traces completos
SHOW_STACK_TRACES=true

# ============================================
# CONFIGURAÇÕES DE PRODUÇÃO
# ============================================

# URL do frontend em produção
FRONTEND_URL=https://flight-log-opus.pages.dev

# Habilitar compressão gzip
ENABLE_COMPRESSION=true

# Habilitar helmet security headers
ENABLE_HELMET=true