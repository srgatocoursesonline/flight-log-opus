{
  "name": "flight-log-opus-backend",
  "version": "1.0.0",
  "description": "Backend API para Flight Log Opus com integração MSFS 2024",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:tracking": "tsx watch src/flight-tracking-server.ts",
    "dev:tracking:simple": "tsx watch src/flight-tracking-server-dev.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "start:tracking": "tsx src/flight-tracking-server.ts",
    "start:tracking:simple": "tsx src/flight-tracking-server-dev.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "postbuild": "echo 'Build completed successfully'"
  },
  "keywords": [
    "flight-log",
    "msfs",
    "aviation",
    "logbook",
    "api",
    "express",
    "typescript"
  ],
  "author": "Flight Log Opus Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "axios": "^1.6.2",
    "ws": "^8.14.2",
    "zod": "^3.22.4",
    "@supabase/supabase-js": "^2.38.4",
    "csv-parser": "^3.0.0",
    "node-cron": "^3.0.3",
    "uuid": "^9.0.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/ws": "^8.5.10",
    "@types/node": "^20.10.4",
    "@types/uuid": "^9.0.7",
    "@types/node-cron": "^3.0.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "tsx": "^4.6.2",
    "rimraf": "^5.0.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/flight-log-opus.git",
    "directory": "backend"
  },
  "bugs": {
    "url": "https://github.com/your-username/flight-log-opus/issues"
  },
  "homepage": "https://flight-log-opus.pages.dev"
}